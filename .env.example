APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AI_CONFIG_SECRET=change-this-local-secret-before-shared-use
DEV_AUTH_DISABLED=true

